# ==============================================================================
# SYNAPSE AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or set variables in your cloud provider.
# NEVER commit the actual '.env' file containing real secrets to version control.

# ── 1. Core Provider Secrets (Required) ───────────────────────────────────────
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── 2. Environment & Runtime Mode ─────────────────────────────────────────────
# Options: development, staging, production
ENVIRONMENT=development
PORT=8000

# ── 3. Relational Database Configuration (PostgreSQL / SQLite) ────────────────
# Option A: Full Connection URI (Used by Render, Heroku, Supabase, Neon)
# In production, use a secure PostgreSQL instance:
DATABASE_URL=postgresql://synapse_user:synapse_secure_pass@localhost:5432/synapse_db
# (If DATABASE_URL and discrete variables are omitted, local SQLite 'sqlite:///./synapse.db' is used automatically)

# Option B: Discrete PostgreSQL Parameters (Alternative to DATABASE_URL)
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=synapse_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapse_db

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Automatic Database Migrations on Startup
# Set to 'true' in development or single-container Docker setups;
# Set to 'false' if running migrations via 'preDeployCommand: python migrate.py'
AUTO_MIGRATE=true

# ── 4. Security & JWT Authentication ──────────────────────────────────────────
# Generate a secure 256-bit random key: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_string_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 5. CORS (Cross-Origin Resource Sharing) ───────────────────────────────────
# Comma-separated list of allowed origins.
# In local development: http://localhost:5173,http://localhost:3000
# In production: https://synapse-ai-research.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── 6. Operational Logging ────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: text (human-readable console), json (structured JSON for log aggregators)
LOG_FORMAT=text

# ── 7. Request Timeouts & Limits ──────────────────────────────────────────────
# Global HTTP request timeout in seconds (returns 504 Gateway Timeout if exceeded)
REQUEST_TIMEOUT_SECONDS=120
# Streaming SSE pipeline timeout in seconds
STREAMING_TIMEOUT_SECONDS=600